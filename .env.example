# Copy to .env.local (local) or set in your hosting provider's environment settings (production).
# Never commit real values.

# This landing page's own URL (subdomain or path) — NOT https://itgeek.com.au, which stays on WordPress.
# Drives canonical, Open Graph, sitemap, robots and (for a path URL) the basePath. CI builds fail if unset.
# e.g. https://support.itgeek.com.au (subdomain, pending client approval) or https://itgeek.com.au/microsoft-365-support (path)
NEXT_PUBLIC_SITE_URL=

# Where enquiry-form submissions are delivered: any HTTPS endpoint that accepts a JSON POST
# (Zapier/Make webhook, CRM inbound webhook, Slack workflow, n8n, etc.). Server-side only.
# Without it, the form shows an error with the phone number — submissions are never faked as successful.
ENQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as the "X-Webhook-Secret" header so the receiver can reject forged calls.
ENQUIRY_WEBHOOK_SECRET=

# Dev server only: true shows a labelled Reviews layout placeholder (never in a build). Leave unset for client review.
NEXT_PUBLIC_SHOW_REVIEW_PLACEHOLDER=

# Launch guard: CI/hosting builds fail while lib/site.ts → launchChecks has unverified items.
# Set to true ONLY to deliberately deploy with unverified content (e.g. a password-protected staging site).
ALLOW_UNVERIFIED_CONTENT=
